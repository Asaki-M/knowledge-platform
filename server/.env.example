HOST=127.0.0.1
PORT=3000

# LLM 仅在创建适配器并调用时使用，不影响 HTTP 服务启动。
OPENAI_API_KEY=
# 使用账号可用的模型 ID，调用时通过 model 参数传入。
OPENAI_MODEL=
# 可选；自定义地址必须支持 Responses API。
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek 普通文本走 Chat Completions；知识提取 JSON Schema 走 Responses API。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 成本优先的起步模型；调用方读取后显式传入 model。
DEEPSEEK_MODEL=deepseek-flash

# HTTP 入库的单节生成预算（包括模型计入的推理 Token）。
# 留空时 DeepSeek 为 32768，OpenAI 为 10000；覆盖值须为模型支持的正整数。
ENRICHMENT_MAX_OUTPUT_TOKENS=

# SiliconFlow Embedding，沿用现有 EMBEDDING_* 配置；不用于通用文本生成。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 官方免费模型，不要误用收费的 Pro/ 前缀版本。
EMBEDDING_MODEL=BAAI/bge-m3

# SiliconFlow Rerank；未单独配置时复用 EMBEDDING_API_KEY / EMBEDDING_BASE_URL。
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_API_KEY=
# RERANK_BASE_URL=https://api.siliconflow.cn/v1

# Gemini Developer API；标准接口在 Free Tier 下免费，付费项目按其计费规则处理。
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2

# Neon PostgreSQL + pgvector；从控制台复制直连连接串（关闭 Connection pooling）。
# 保留连接串中的 SSL 参数；入库断点使用会话锁，不能使用带 -pooler 的地址。
VECTOR_DATABASE_URL=

# 公网只读 MCP / OAuth；MCP_PUBLIC_URL 为域名根地址，不含 /mcp。
# 本地联调可设 http://127.0.0.1:3000，Vercel 使用 https://项目域名。
MCP_PUBLIC_URL=
MCP_OAUTH_CLIENT_ID=knowledge-platform
# 以下三项使用不同的至少 32 字符随机值；仅 CLIENT_SECRET 填入 ChatGPT 客户端设置。
MCP_OAUTH_CLIENT_SECRET=
MCP_TOKEN_SECRET=
MCP_ACCESS_PASSWORD=
# 默认允许 ChatGPT 的稳定回调；其他客户端需逐字添加实际回调，逗号分隔。
MCP_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect

OTEL_SERVICE_NAME=knowledge-server
# console: 本地查看；otlp: 导出到 Collector；none: 关闭对应信号。
OTEL_TRACES_EXPORTER=console
OTEL_LOGS_EXPORTER=console
# 切换到 otlp 后，配置 Collector 地址。也支持 http/protobuf 和 grpc。
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer your-token
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
# OTEL_SDK_DISABLED=true
