HOST=127.0.0.1
PORT=3000

# LLM 仅在创建适配器并调用时使用，不影响 HTTP 服务启动。
OPENAI_API_KEY=
# 使用账号可用的模型 ID，调用时通过 model 参数传入。
OPENAI_MODEL=
# 可选；自定义地址必须支持 Responses API。
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek 使用 OpenAI SDK 的 Chat Completions API。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 成本优先的起步模型；调用方读取后显式传入 model。
DEEPSEEK_MODEL=deepseek-flash

# HTTP 入库的单节生成预算（包括模型计入的推理 Token）。
# 留空时 DeepSeek 为 32768，OpenAI 为 10000；覆盖值须为模型支持的正整数。
ENRICHMENT_MAX_OUTPUT_TOKENS=

# SiliconFlow Embedding，沿用现有 EMBEDDING_* 配置；不用于通用文本生成。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 官方免费模型，不要误用收费的 Pro/ 前缀版本。
EMBEDDING_MODEL=BAAI/bge-m3

# SiliconFlow Rerank；未单独配置时复用 EMBEDDING_API_KEY / EMBEDDING_BASE_URL。
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_API_KEY=
# RERANK_BASE_URL=https://api.siliconflow.cn/v1

# Gemini Developer API；标准接口在 Free Tier 下免费，付费项目按其计费规则处理。
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2

# 本地 PostgreSQL + pgvector；密码与连接串中的密码保持一致。
VECTOR_DB_PASSWORD=
# 例如 postgresql://knowledge:replace-me@127.0.0.1:5432/knowledge
VECTOR_DATABASE_URL=

OTEL_SERVICE_NAME=knowledge-server
# console: 本地查看；otlp: 导出到 Collector；none: 关闭对应信号。
OTEL_TRACES_EXPORTER=console
OTEL_LOGS_EXPORTER=console
# 切换到 otlp 后，配置 Collector 地址。也支持 http/protobuf 和 grpc。
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer your-token
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
# OTEL_SDK_DISABLED=true
