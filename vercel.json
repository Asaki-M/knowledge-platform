{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "buildCommand": "pnpm --filter @knowledge/server build",
  "outputDirectory": "server/public",
  "functions": {
    "api/mcp.mjs": {
      "maxDuration": 300,
      "includeFiles": "server/dist/**"
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp?__mcp_route=/mcp" },
    { "source": "/.well-known/:path*", "destination": "/api/mcp?__mcp_route=/.well-known/:path*" },
    { "source": "/oauth/:path*", "destination": "/api/mcp?__mcp_route=/oauth/:path*" }
  ]
}
